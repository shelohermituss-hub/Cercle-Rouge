    <string name="retention_title">How long should recordings be kept?</string>
    <string name="retention_body">They are only made during an alert, encrypted on your phone, then deleted automatically.</string>
    <string name="retention_24h">24 hours</string>
    <string name="retention_24h_ex">Enough to reassure your contacts, then everything is gone.</string>
    <string name="retention_7d">7 days</string>
    <string name="retention_7d_ex">Time to decide whether to file a report.</string>
    <string name="retention_30d">30 days</string>
    <string name="retention_30d_ex">The maximum, for a longer process.</string>
    <string name="retention_closure">Delete when the alert ends</string>
    <string name="retention_closure_ex">Nothing is kept once you are safe.</string>
    <string name="pin_title">Create your PIN</string>
    <string name="pin_body">It protects turning protection off: without it, someone could stop your alert. It is required for a protected trip.</string>
